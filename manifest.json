{
  "manifest_version": 3,
  "name": "Lyrics Side Panel",
  "version": "0.1.0",
  "description": "Shows lyrics for the song playing in your browser, in Chrome's side panel.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["https://lrclib.net/*", "https://api.lyrics.ovh/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "js": ["content/selectors.js", "content/detector.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Show lyrics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+L" },
      "description": "Open the lyrics side panel"
    }
  }
}
